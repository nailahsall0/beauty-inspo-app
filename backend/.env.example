# Backend Environment Variables
# Copy this file to .env and fill in your values
# For production, set these in Railway dashboard instead

# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://brookie_app:PASSWORD@brookie-cluster.xxxxx.mongodb.net/brookie?retryWrites=true&w=majority
DB_NAME=brookie

# Cloudflare R2 (or S3-compatible) storage
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY=your-r2-access-key
S3_SECRET_KEY=your-r2-secret-key
S3_BUCKET=brookie-media

# JWT Authentication
# Generate secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-64-character-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=1440

# Admin account (for database seeding)
ADMIN_EMAIL=admin@brook.ie
ADMIN_PASSWORD=your-strong-admin-password

# Test accounts (optional - skip seeding demo data if not set)
SEED_TEST_PASSWORD=your-test-password

# Upload limits
MAX_UPLOAD_SIZE_MB=50
